# Copie para .env e preencha. NUNCA versione o .env.

# --- Servidor ---
PORT=3000
DATABASE_PATH=./data/atendimento.db
# Token para o endpoint /admin/resume (gere um valor aleatório longo)
ADMIN_TOKEN=
TIMEZONE=America/Sao_Paulo
# Blocos separados por ";" — dias: dom seg ter qua qui sex sab
BUSINESS_HOURS=seg-sex 08:00-18:00

# --- Claude (API da Anthropic — cobrança separada do plano Pro) ---
ANTHROPIC_API_KEY=
# claude-opus-5-5 (padrão) | claude-sonnet-5-5 | claude-haiku-5-5
LLM_MODEL=claude-opus-5-5
# low | medium | high  (low é suficiente para atendimento)
LLM_EFFORT=low

# --- WhatsApp Cloud API (Meta) ---
# App Secret do app na Meta (Configurações do app → Básico)
WHATSAPP_APP_SECRET=
# Texto livre que você também informa na tela de configuração do webhook da Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
# Um número (v1):
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_CHANNEL_LABEL=Suporte GateIT
# Vários números (opcional, substitui as 3 linhas acima). Tokens ficam em variáveis próprias:
# WHATSAPP_CHANNELS=[{"phone_number_id":"111","label":"Suporte"},{"phone_number_id":"222","label":"Cliente X","access_token_env":"WHATSAPP_TOKEN_CLIENTE_X","tomticket_department_id":"abc"}]

# --- TomTicket (API v2.0) ---
# Administração → Configurações da Conta → API → Novo Token
TOMTICKET_TOKEN=
TOMTICKET_BASE_URL=https://api.tomticket.com/v2.0
# Rode "npm run tomticket:check" para descobrir os IDs
TOMTICKET_DEPARTMENT_ID=
TOMTICKET_CATEGORY_ID=
# true: só mostra chamados se o WhatsApp do cliente estiver no cadastro do TomTicket
REQUIRE_PHONE_MATCH_FOR_LOOKUP=true

# --- Agente ---
AGENT_NAME=Gate
COMPANY_NAME=GateIT
SESSION_TTL_HOURS=12
HANDOFF_PAUSE_HOURS=4
DEBOUNCE_MS=4000
SLA_TEXT=Urgente: retorno em até 1h útil; Alta: até 4h úteis; Normal: até 1 dia útil; Baixa: até 3 dias úteis.

# --- Aviso à equipe (handoff) ---
# URL que recebe POST JSON {text, ...} — Teams (Workflows), Slack, n8n, Make...
HANDOFF_WEBHOOK_URL=
